<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starlink.cashier.mapper.PaymentRecordMapper">

    <select id="selectByOrderId" resultType="com.starlink.cashier.entity.PaymentRecord">
        SELECT *
        FROM payment_record
        WHERE order_id = #{orderId}
          AND payment_status = 1
          AND deleted_at IS NULL
        LIMIT 1
    </select>

    <select id="selectByOrderIdList" resultType="com.starlink.cashier.entity.PaymentRecord">
        SELECT *
        FROM payment_record
        WHERE order_id IN
        <foreach collection="orderIds" item="orderId" open="(" separator="," close=")">
            #{orderId}
        </foreach>
        AND deleted_at IS NULL
        ORDER BY created_at DESC
    </select>

</mapper>
