<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starlink.cashier.mapper.OrderItemMapper">

    <select id="selectByOrderId" resultType="com.starlink.cashier.entity.OrderItem">
        SELECT *
        FROM order_item
        WHERE order_id = #{orderId}
          AND deleted_at IS NULL
        ORDER BY id ASC
    </select>

</mapper>
