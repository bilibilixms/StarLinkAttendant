<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starlink.system.mapper.EmployeeRoleMapper">

    <delete id="deleteByEmployeeId">
        DELETE FROM employee_role WHERE employee_id = #{employeeId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM employee_role WHERE role_id = #{roleId}
    </delete>

    <select id="selectRoleIdsByEmployeeId" resultType="java.lang.Long">
        SELECT role_id FROM employee_role WHERE employee_id = #{employeeId}
    </select>

    <insert id="batchInsert">
        INSERT INTO employee_role (employee_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{employeeId}, #{roleId})
        </foreach>
    </insert>

</mapper>